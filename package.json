{
  "name": "qijian-qiannian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android",
    "preview": "vite preview",
    "android:add": "npm run build:android && npm run capacitor -- add android",
    "android:apk": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-apk.ps1 && npm run build",
    "android:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/configure-android.ps1",
    "android:sync": "npm run build:android && npm run capacitor -- sync android",
    "android:open": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/open-android.ps1",
    "android:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android-emulator.ps1",
    "android:emulator:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android-emulator.ps1 -Build",
    "capacitor": "node -r ./scripts/node-user-info-fallback.cjs ./node_modules/@capacitor/cli/bin/capacitor"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.7"
  }
}
